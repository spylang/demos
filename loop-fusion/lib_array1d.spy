from unsafe import gc_alloc, gc_ptr
from operator import OpSpec, MetaArg
from __spy__ import force_inline


@struct
class ArrayData[DTYPE]:
    shape: gc_ptr[i32]
    items: gc_ptr[DTYPE]


@blue.generic
def ndarray(DTYPE):
    ArrayData_c = ArrayData[DTYPE]

    @struct
    class Self:
        __ll__: gc_ptr[ArrayData_c]

        @blue.metafunc
        def __new__(*args_m):
            NDIM = 1
            if NDIM == 1:

                def new(n0: i32) -> Self:
                    ll = gc_alloc[ArrayData_c](1)
                    ll.shape = gc_alloc[i32](NDIM)
                    ll.shape[0] = n0
                    total = n0
                    ll.items = gc_alloc[DTYPE](total)
                    return Self.__make__(ll)

                m_n0: MetaArg = args_m[1]
            return OpSpec(new, [m_n0])

        def __getitem__(self: Self, i: i32) -> DTYPE:
            return self.__ll__.items[i]

        def __setitem__(self: Self, i: i32, val: DTYPE) -> None:
            self.__ll__.items[i] = val

        def size(self: Self) -> i32:
            return self.__ll__.shape[0]

        @blue.metafunc
        def __add__(m_self, m_other):
            LEFT_T = m_self.static_type
            RIGHT_T = m_other.static_type
            Lazy = LazyAdd[DTYPE, LEFT_T, RIGHT_T]

            def add(a: LEFT_T, b: RIGHT_T) -> Lazy:
                return Lazy.__make__(a, b)

            return OpSpec(add)

        @blue
        @classmethod
        def make_kernel(cls):
            @force_inline
            def kernel(arr: Self, i: i32) -> DTYPE:
                return arr.__ll__.items[i]

            return kernel

        def fill(self, val: f64) -> None:
            """Fill array with a constant value."""
            for i in range(self.size()):
                self[i] = val

    return Self


@blue.generic
def LazyAdd(DTYPE, LEFT_T, RIGHT_T):
    A = ndarray[DTYPE]

    @struct
    class Self:
        left: LEFT_T
        right: RIGHT_T

        def size(self: Self) -> i32:
            return self.left.size()

        @blue
        @classmethod
        def make_kernel(cls):
            left_kernel = LEFT_T.make_kernel()
            right_kernel = RIGHT_T.make_kernel()

            @force_inline
            def kernel(expr: Self, i: i32) -> DTYPE:
                return left_kernel(expr.left, i) + right_kernel(expr.right, i)

            return kernel

        @blue.metafunc
        def __convert_to__(m_expT, m_gotT, m_x):
            if m_expT.blueval == A:
                kernel = Self.make_kernel()

                def materialize(expr: Self) -> A:
                    n = expr.left.size()
                    out = A(n)
                    for i in range(n):
                        out[i] = kernel(expr, i)
                    return out

                return OpSpec(materialize, [m_x])
            return OpSpec.NULL

        @blue.metafunc
        def __add__(m_self, m_other):
            LEFT_T2 = m_self.static_type
            RIGHT_T2 = m_other.static_type
            Lazy = LazyAdd[DTYPE, LEFT_T2, RIGHT_T2]

            def add(a: LEFT_T2, b: RIGHT_T2) -> Lazy:
                return Lazy.__make__(a, b)

            return OpSpec(add)

    return Self


def main() -> None:
    N: i32 = 8
    x = ndarray[f64](N)
    x.fill(1.0)

    out1: ndarray[f64] = x + x + x

    assert out1[0] == 3
