"""
Expression fusion demo for SPy

"""

from unsafe import gc_alloc, gc_ptr
from operator import OpSpec, MetaArg
import math
from __spy__ import force_inline


def ptr2list(ptr: gc_ptr[i32], length: i32) -> list[i32]:
    ret: list[i32] = []
    for idx in range(length):
        ret.append(ptr[idx])
    return ret


@struct
class ArrayData[DTYPE]:
    shape: gc_ptr[i32]
    items: gc_ptr[DTYPE]


@blue.generic
def ndarray(DTYPE, NDIM):
    if NDIM > 2:
        raise StaticError("NDIM > 2 not supported")

    ArrayData_c = ArrayData[DTYPE]

    @struct
    class Self:
        _DTYPE = DTYPE
        _NDIM = NDIM

        __ll__: gc_ptr[ArrayData_c]

        @blue.metafunc
        def __new__(*args_m):
            if len(args_m) != NDIM + 1:
                raise StaticError("Wrong number of shape arguments")

            # def new(*args: Args[NDIM, i32]) -> Self:
            #     ll = gc_alloc[ArrayData_c](1)
            #     ll.shape = gc_alloc[i32](NDIM)
            #     for i, n in unroll(enumerate(args)):
            #         ll.shape[i] = n
            #     _size = 1
            #     for n in unroll(args):
            #         _size = _size * n
            #     ll.items = gc_alloc[DTYPE](_size)
            #     return Self.__make__(ll)

            if NDIM == 1:

                def new(n0: i32) -> Self:
                    ll = gc_alloc[ArrayData_c](1)
                    ll.shape = gc_alloc[i32](NDIM)
                    ll.shape[0] = n0
                    _size = n0
                    ll.items = gc_alloc[DTYPE](_size)
                    return Self.__make__(ll)

                m_n0: MetaArg = args_m[1]
                return OpSpec(new, [m_n0])
            elif NDIM == 2:

                def new(n0: i32, n1: i32) -> Self:
                    ll = gc_alloc[ArrayData_c](1)
                    ll.shape = gc_alloc[i32](NDIM)
                    ll.shape[0] = n0
                    ll.shape[1] = n1
                    _size = n0 * n1
                    ll.items = gc_alloc[DTYPE](_size)
                    return Self.__make__(ll)

                m_n0: MetaArg = args_m[1]
                m_n1: MetaArg = args_m[2]
                return OpSpec(new, [m_n0, m_n1])
            else:
                raise StaticError("Should never happen")

        @blue.metafunc
        def size(m_self):
            # def _size(self: Self) -> i32:
            #     _size = 1
            #     for dim in unroll(range(NDIM)):
            #         _size = _size * self.__ll__.shape[dim]
            #     return _size
            if NDIM == 1:

                def _size(self: Self) -> i32:
                    return self.__ll__.shape[0]
            elif NDIM == 2:

                def _size(self: Self) -> i32:
                    shape = self.__ll__.shape
                    return shape[0] * shape[1]
            else:
                raise StaticError("Should never happen")

            return OpSpec(_size)

        @blue.metafunc
        def __setitem__(*args_m):
            if len(args_m) != NDIM + 2:
                raise StaticError("Wrong number of shape arguments")

            if NDIM == 1:

                def setitem(self: Self, i0: i32, val: DTYPE) -> None:
                    self.__ll__.items[i0] = val

            elif NDIM == 2:

                def setitem(self: Self, i0: i32, i1: i32, val: DTYPE) -> None:
                    ll = self.__ll__
                    idx = (i0 * ll.shape[1]) + i1
                    ll.items[idx] = val

            return OpSpec(setitem)

        @blue.metafunc
        def __getitem__(*args_m):
            if len(args_m) != NDIM + 1:
                raise StaticError("Wrong number of shape arguments")

            if NDIM == 1:

                def getitem(self: Self, i0: i32) -> DTYPE:
                    return self.__ll__.items[i0]

            elif NDIM == 2:

                def getitem(self: Self, i0: i32, i1: i32) -> DTYPE:
                    ll = self.__ll__
                    idx = (i0 * ll.shape[1]) + i1
                    return ll.items[idx]

            return OpSpec(getitem)

        @blue.metafunc
        def __add__(m_self, m_other):
            LEFT_T = m_self.static_type
            RIGHT_T = m_other.static_type
            Lazy = LazyAdd[DTYPE, NDIM, LEFT_T, RIGHT_T]

            def add(a: LEFT_T, b: RIGHT_T) -> Lazy:
                return Lazy.__make__(a, b)

            return OpSpec(add)

        @blue
        @classmethod
        def make_kernel(cls):
            if NDIM == 1:

                @force_inline
                def kernel(self: Self, i: i32) -> DTYPE:
                    return self.__ll__.items[i]

            if NDIM == 2:

                @force_inline
                def kernel(self: Self, i0: i32, i1: i32) -> DTYPE:
                    return self.__ll__.items[(i0 * self.__ll__.shape[1]) + i1]

            return kernel

        @property
        def shape(self) -> list[i32]:
            return ptr2list(self.__ll__.shape, NDIM)

        def fill(self, val: DTYPE) -> None:
            for i in range(self.size()):
                self.__ll__.items[i] = val

    return Self


@blue.generic
def LazyAdd(DTYPE, NDIM, LEFT_T, RIGHT_T):
    A = ndarray[DTYPE, NDIM]

    @struct
    class Self:
        _DTYPE = DTYPE
        _NDIM = NDIM

        left: LEFT_T
        right: RIGHT_T

        def size(self: Self) -> i32:
            return self.left.size()

        @property
        def shape(self) -> list[i32]:
            return self.left.shape

        @blue
        @classmethod
        def make_kernel(cls):
            left_kernel = LEFT_T.make_kernel()
            right_kernel = RIGHT_T.make_kernel()

            if NDIM == 1:

                @force_inline
                def kernel(expr: Self, i: i32) -> DTYPE:
                    return left_kernel(expr.left, i) + right_kernel(expr.right, i)

            elif NDIM == 2:

                @force_inline
                def kernel(expr: Self, i0: i32, i1: i32) -> DTYPE:
                    return left_kernel(expr.left, i0, i1) + right_kernel(
                        expr.right, i0, i1
                    )

            return kernel

        @blue.metafunc
        def __convert_to__(m_expT, m_gotT, m_x):
            if m_expT.blueval == A:
                kernel = Self.make_kernel()

                if NDIM == 1:

                    def materialize(expr: Self) -> A:
                        n = expr.left.size()
                        out = A(n)
                        for i in range(n):
                            out[i] = kernel(expr, i)
                        return out

                elif NDIM == 2:

                    def materialize(expr: Self) -> A:
                        shape = expr.left.shape
                        n0 = shape[0]
                        n1 = shape[1]
                        out = A(n0, n1)

                        for i0 in range(n0):
                            for i1 in range(n1):
                                out[i0, i1] = kernel(expr, i0, i1)
                        return out

                return OpSpec(materialize, [m_x])
            return OpSpec.NULL

        @blue.metafunc
        def __add__(m_self, m_other):
            LEFT_T2 = m_self.static_type
            RIGHT_T2 = m_other.static_type
            Lazy = LazyAdd[DTYPE, NDIM, LEFT_T2, RIGHT_T2]

            def add(a: LEFT_T2, b: RIGHT_T2) -> Lazy:
                return Lazy.__make__(a, b)

            return OpSpec(add)

    return Self


@blue.generic
def LazySin(DTYPE, NDIM, ARG_TYPE):
    A = ndarray[DTYPE, NDIM]

    @struct
    class Self:
        _DTYPE = DTYPE
        _NDIM = NDIM

        arg: ARG_TYPE

        @blue
        @classmethod
        def make_kernel(cls):
            arg_kernel = ARG_TYPE.make_kernel()

            if NDIM == 1:

                @force_inline
                def kernel(expr: Self, i: i32) -> DTYPE:
                    return math.sin(arg_kernel(expr.arg, i))

            elif NDIM == 2:

                @force_inline
                def kernel(expr: Self, i0: i32, i1: i32) -> DTYPE:
                    return math.sin(arg_kernel(expr.arg, i0, i1))

            return kernel

        def size(self: Self) -> i32:
            return self.arg.size()

        @property
        def shape(self) -> list[i32]:
            return self.arg.shape

        @blue.metafunc
        def __convert_to__(m_expT, m_gotT, m_x):
            if m_expT.blueval == A:
                kernel = Self.make_kernel()

                if NDIM == 1:

                    def materialize(expr: Self) -> A:
                        n = expr.arg.size()
                        out = A(n)
                        for i in range(n):
                            out[i] = kernel(expr, i)
                        return out

                elif NDIM == 2:

                    def materialize(expr: Self) -> A:
                        shape = expr.arg.shape
                        n0 = shape[0]
                        n1 = shape[1]
                        out = A(n0, n1)
                        for i0 in range(n0):
                            for i1 in range(n1):
                                out[i0, i1] = kernel(expr, i0, i1)
                        return out

                return OpSpec(materialize, [m_x])
            return OpSpec.NULL

        @blue.metafunc
        def __add__(m_self, m_other):
            LEFT_T = m_self.static_type
            RIGHT_T = m_other.static_type
            Lazy = LazyAdd[DTYPE, NDIM, LEFT_T, RIGHT_T]

            def add(a: LEFT_T, b: RIGHT_T) -> Lazy:
                return Lazy.__make__(a, b)

            return OpSpec(add)

    return Self


# ---------------------------------------------------------------------------
# sin ; free metafunction
#
# Dispatches on the static type of its argument:
#   - scalar f64  -> eager math.sin call
#   - ndarray     -> LazySin node (no computation)
# ---------------------------------------------------------------------------


@blue.metafunc
def sin(m_x):
    T = m_x.static_type

    if T == f64:

        def sin_scalar(x: f64) -> f64:
            return math.sin(x)

        return OpSpec(sin_scalar)

    # Generic array case: extract DTYPE and NDIM from the ndarray type
    # and return a LazySin node.

    # We would like to be able to get DTYPE and NDIM (blue values) from T

    # We will be able to have (hasattr not yet avail but should be easy, see
    # https://github.com/spylang/spy/issues/247#issuecomment-4155144151)

    # if hasattr(T, "_DTYPE") and hasattr(T, "_NDIM"):

    if True:
        DTYPE = T._DTYPE
        NDIM = T._NDIM
        A = ndarray[DTYPE, NDIM]
        Lazy = LazySin[DTYPE, NDIM, A]

        def sin_lazy(x: A) -> Lazy:
            return Lazy.__make__(x)

        return OpSpec(sin_lazy)

    # We would like to be able to have blue iterators
    # for DTYPE in unroll([f32, f64]):

    # raise StaticError(f"sin not defined for {T}")


def main() -> None:
    N = 8
    x = ndarray[f64, 1](N)
    x.fill(1.0)

    x2 = ndarray[f64, 2](N, N)
    x2.fill(1.0)

    # -----------------------------------------------------------------------
    # Case 1: simple addition — x + x
    #
    # LazyAdd[f64, 1, ndarray[f64,1], ndarray[f64,1]] is built at runtime,
    # then __convert_to__ materialises it in one loop:
    #   out[i] = x[i] + x[i]
    # -----------------------------------------------------------------------
    out1: ndarray[f64, 1] = x + x
    assert out1[0] == 2.0

    out1 = x + x + x
    assert out1[0] == 3.0

    out2: ndarray[f64, 2] = x2 + x2
    assert out2[0, 0] == 2.0

    out2 = x2 + x2 + x2
    assert out2[0, 0] == 3.0

    # -----------------------------------------------------------------------
    # Case 2: x + sin(x)
    #
    # 1.0 + sin(1.0) \simeq 1.8415
    # -----------------------------------------------------------------------

    out1_sin: ndarray[f64, 1] = x + sin(x)
    assert abs(out1_sin[0] - 1.84147) < 0.00001

    out2_sin: ndarray[f64, 2] = x2 + sin(x2)
    assert abs(out2_sin[0, 0] - 1.84147) < 0.00001
